func get_shared_material(col: Color, roughness: float, metal: float, norm_tex: Texture2D, emit_col: Color) -> StandardMaterial3D:
	if emit_col != Color.BLACK:
		var unique_mat = StandardMaterial3D.new()
		unique_mat.albedo_color = col
		unique_mat.roughness = roughness
		unique_mat.metallic = metal
		unique_mat.cull_mode = StandardMaterial3D.CULL_DISABLED
		unique_mat.emission_enabled = true
		unique_mat.emission = emit_col
		unique_mat.emission_energy_multiplier = 2.2
		return unique_mat

	var key = "%s_%.2f_%.2f_%s" % [col.to_html(), roughness, metal, str(norm_tex)]
	if mat_cache.has(key):
		return mat_cache[key]
	
	var mat = StandardMaterial3D.new()
	mat.albedo_color = col
	mat.roughness = roughness
	mat.metallic = metal
	mat.cull_mode = StandardMaterial3D.CULL_DISABLED
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	
	if norm_tex:
		mat.normal_enabled = true
		mat.normal_texture = norm_tex
		mat.uv1_triplanar = true
		mat.uv1_world_triplanar = true
		if norm_tex == brick_normal:
			mat.albedo_texture = brick_albedo_tex
			mat.uv1_scale = Vector3(0.35, 0.35, 0.35)
		elif norm_tex == road_normal:
			mat.roughness_texture = road_rough_tex
			mat.uv1_scale = Vector3(0.15, 0.15, 0.15)
		else:
			mat.uv1_scale = Vector3(0.25, 0.25, 0.25)
	mat_cache[key] = mat
	return mat

func get_shared_box_mesh(size: Vector3) -> BoxMesh:
	var key = "%.2f_%.2f_%.2f" % [size.x, size.y, size.z]
	if box_mesh_cache.has(key):
		return box_mesh_cache[key]
	var bm = BoxMesh.new()
	bm.size = size
	box_mesh_cache[key] = bm
	return bm

func make_block(pos: Vector3, size: Vector3, col: Color, parent: Node3D, use_col: bool = true, roughness: float = 0.8, metal: float = 0.0, norm_tex: Texture2D = null, emit_col: Color = Color.BLACK) -> MeshInstance3D:
	var mi = MeshInstance3D.new()
	mi.mesh = get_shared_box_mesh(size)
	mi.position = pos
	mi.material_override = get_shared_material(col, roughness, metal, norm_tex, emit_col)
	
	if size.x < 2.2 and size.y < 2.2 and size.z < 2.2 and emit_col == Color.BLACK:
		mi.visibility_range_end = 70.0
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF

	if use_col:
		var sb = StaticBody3D.new()
		var cs = CollisionShape3D.new()
		var shape = BoxShape3D.new()
		shape.size = size
		cs.shape = shape
		sb.add_child(cs)
		mi.add_child(sb)
	parent.add_child(mi)
	return mi

func make_cyl(pos: Vector3, radius: float, height: float, col: Color, parent: Node3D, rot_deg: Vector3 = Vector3.ZERO, emit_col: Color = Color.BLACK, top_rad: float = -1.0) -> MeshInstance3D:
	var mi = MeshInstance3D.new()
	var cm = CylinderMesh.new()
	cm.top_radius = radius if top_rad < 0.0 else top_rad
	cm.bottom_radius = radius
	cm.height = height
	mi.mesh = cm
	mi.position = pos
	mi.rotation_degrees = rot_deg
	mi.material_override = get_shared_material(col, 0.6, 0.1, null, emit_col)
	parent.add_child(mi)
	return mi

func make_3d_text(pos: Vector3, text_str: String, f_size: int, col: Color, parent: Node3D, rot_y: float = 0.0) -> Label3D:
