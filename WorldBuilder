func get_closest_interaction(player_pos: Vector3) -> Dictionary:
	var best: Dictionary = {}
	var best_d: float = 999.0
	for item in interact_points:
		var n: Node3D = item["node"]
		if is_instance_valid(n):
			var d = player_pos.distance_to(n.global_position)
			if d <= item["radius"] and d < best_d:
				best_d = d
				best = item
	return best

func get_street_zone_name(h_num: int) -> String:
	if h_num >= 40:
		return "Abington Park Crescent (East)"
	elif h_num >= 30:
		return "Mounts Link Rd Flats (West)"
	elif h_num >= 20:
		return "Spinney Hill Ave (North)"
	elif h_num % 2 == 1:
		return "Kettering Rd (South Side)"
	return "Kettering Rd (North Side)"

