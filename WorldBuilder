func trigger_interaction(player: Node3D, item: Dictionary) -> void:
	var act = item.get("action", "")
	var h_num = item.get("house_num", -1)
	if act == "craig":
		player.show_toast("💬 Craig: '21 properties across 5 Northampton districts live on the board mate!'")
	elif act == "dave":
		player.show_toast("📋 Warehouse Dave: 'Check out the new glazed storefronts at Threadfix, Greg's & C&F Wholesale!'")
	elif act == "shoo_kev":
		kev_npc.global_position = Vector3(-95, 0.1, 6.8)
		player.show_toast("🏃‍♂️ Sticky-Fingers Kev: 'Alright mate, I was only admiring the ladder rack!'")
	elif act == "buy_stock":
		if player.cash < 40:
			player.show_toast("⚠️ Need £40 for an HQ Stock Pack.")
		else:
			player.cash -= 40
			player.stock["Alarm"] += 1
			player.stock["Bell"] += 1
			player.stock["CCTV"] += 1
			player.update_hud()
			player.show_toast("📦 Loaded +1 Alarm, +1 Bell & +1 CCTV from HQ!")
	elif act == "buy_threadfix":
		if player.cash < 70:
			player.show_toast("⚠️ Need £70 for a Threadfix Trade Bulk Pack!")
		else:
			player.cash -= 70
			player.stock["Alarm"] += 2
			player.stock["Bell"] += 2
			player.stock["CCTV"] += 2
			player.update_hud()
			player.show_toast("🛒 THREADFIX BULK DISCOUNT: Loaded +2 Alarms, +2 Bells & +2 CCTV Kits!")
	elif act == "buy_cf_mega":
		if player.cash < 130:
			player.show_toast("⚠️ Need £130 for a C&F Wholesale Mega-Crate!")
		else:
			player.cash -= 130
			player.stock["Alarm"] += 4
			player.stock["Bell"] += 4
			player.stock["CCTV"] += 4
			player.update_hud()
			player.show_toast("⚡ C&F WHOLESALE MEGA-CRATE: Loaded +4 Alarms, +4 Bells & +4 CCTV Kits!")
	elif act == "buy_greggs":
		if player.cash < 2:
			player.show_toast("⚠️ You don't even have £2 for a Greggs mate!")
		else:
			player.cash -= 2
			player.speed_boost = 1.25
			player.update_hud()
			player.show_toast("🥐 GREG'S SAUSAGE ROLL & ESPRESSO: +25% Engineer Walk/Sprint Speed Active!")
	elif act == "phone":
		target_house_num = all_job_Numbers[randi() % all_job_Numbers.size()]
		var jd = job_defs[randi() % job_defs.size()]
		target_job_key = jd["key"]
		var zone_txt = get_street_zone_name(target_house_num)
		player.active_job = "%s at #%d %s" % [jd["title"], target_house_num, zone_txt]
		player.update_hud()
		player.show_toast("📞 DISPATCH: Drive to #" + str(target_house_num) + " " + zone_txt + " for a " + jd["title"] + "!")
	elif act == "toggle_door":
		var pivot: Node3D = item.get("extra")
		if pivot:
			var open_state = !pivot.get_meta("is_open")
			pivot.set_meta("is_open", open_state)
			var tw = create_tween()
			tw.tween_property(pivot, "rotation_degrees:y", -88.0 if open_state else 0.0, 0.35)
			player.show_toast("🚪 Front door at #" + str(h_num) + (" opened." if open_state else " closed."))
	elif act == "van":
		van_locked = false
		active_driver = player
		player.in_van = true
		player.current_van = self
		player.visible = false
		player.get_node("CollisionShape3D").disabled = true
		van_cam.make_current()
		player.show_toast("🚐 Driving Van! [W/S] Drive | [A/D] Steer | [H] Headlights | [E] Exit")
	elif act == "ladder":
		var n: Node3D = item["node"]
		spawn_temporary_ladder(n)
		player.on_ladder = true
		player.global_position = n.global_position + Vector3(0, 1.8, 0)
		player.show_toast("🪜 Pitched Temporary Ladder! Hold [W] to climb up to 4.2m, or [Space] to pack ladder away!")
	elif act in ["job_alarm", "job_bell", "job_cctv"]:
		var req_key = "Alarm" if act == "job_alarm" else ("Bell" if act == "job_bell" else "CCTV")
		if target_house_num == -1:
			player.show_toast("⚠️ Answer the ringing phone on Craig's desk in HQ first!")
		elif h_num != target_house_num:
			player.show_toast("⚠️ Wrong property! Active callout is at #" + str(target_house_num) + " (" + get_street_zone_name(target_house_num) + ")!")
		elif req_key != target_job_key:
			player.show_toast("⚠️ Wrong unit! This callout is for the " + target_job_key + " at #" + str(h_num) + "!")
		elif player.stock.get(target_job_key, 0) <= 0:
			player.show_toast("⚠️ OUT OF STOCK! Visit Threadfix, C&F or HQ for a " + target_job_key + " kit!")
		else:
			player.open_job_minigame(h_num, target_job_key, player.active_job, item.get("extra"))

