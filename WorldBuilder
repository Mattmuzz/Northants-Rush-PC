func build_surrounding_landscape() -> void:
	var env_hills = Node3D.new()
	env_hills.name = "SurroundingHills"
	add_child(env_hills)
	
	# Distant rolling green hillsides around the entire town perimeter
	var hill_ring = [
		Vector3(0, 14, -360), Vector3(-240, 18, -320), Vector3(240, 16, -320),
		Vector3(0, 15, 340),  Vector3(-240, 19, 300),  Vector3(240, 14, 300),
		Vector3(-360, 18, 0), Vector3(-340, 14, -180), Vector3(-340, 16, 180),
		Vector3(360, 17, 0),  Vector3(340, 15, -180),  Vector3(340, 19, 180)
	]
	for hp in hill_ring:
		make_cyl(hp, 155.0, hp.y * 2.2, Color("14532d"), env_hills, Vector3.ZERO, Color.BLACK, 65.0)
	
	# Outer Perimeter Woodland Copse & Hedgerows
	for angle_deg in range(0, 360, 10):
		var rad = deg_to_rad(angle_deg)
		var dist = 215.0 + (angle_deg % 3) * 14.0
		var tx = cos(rad) * dist
		var tz = sin(rad) * dist
		make_realistic_tree(env_hills, Vector3(tx, 0, tz), 1.5 + (angle_deg % 4) * 0.25, angle_deg % 20 == 0)

