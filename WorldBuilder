func exit_van() -> void:
	if not active_driver:
		return
	var p = active_driver
	active_driver = null
	van_speed = 0.0
	p.in_van = false
	p.current_van = null
	p.global_position = van_body.global_position + Vector3(-2.6, 1.0, 0)
	p.visible = true
	p.get_node("CollisionShape3D").disabled = false
	p.camera.make_current()
	p.show_toast("👟 Stepped out of the van. Press [L] to lock the doors!")

func _physics_process(delta: float) -> void:
	var t = Time.get_ticks_msec() * 0.01
	if phone_light:
		phone_light.light_energy = 1.6 + sin(t * 1.4) * 1.3
	if van_beacon_light:
		van_beacon_light.light_energy = 2.0 + sin(t * 2.2) * 1.8
	if tower_beacon:
		tower_beacon.light_energy = 4.0 + sin(t * 0.6) * 3.5

	# Automatically remove temporary pitched ladder when player steps off
	var player = get_node_or_null("Player")
	if player and not player.on_ladder and temp_ladder_mesh and is_instance_valid(temp_ladder_mesh):
		temp_ladder_mesh.queue_free()
		temp_ladder_mesh = null

	if dave_npc:
		if dave_wait_timer > 0.0:
			dave_wait_timer -= delta
			dave_npc.get_node("LegL").rotation_degrees.x = 0
			dave_npc.get_node("LegR").rotation_degrees.x = 0
		else:
			var target_wp = dave_waypoints[dave_waypoint_idx]
			if dave_npc.position.distance_to(target_wp) < 0.25:
				dave_wait_timer = 2.5
				dave_waypoint_idx = (dave_waypoint_idx + 1) % dave_waypoints.size()
			else:
				var dir = (target_wp - dave_npc.position).normalized()
				dave_npc.position += dir * 1.6 * delta
				dave_npc.rotation.y = atan2(-dir.x, -dir.z)
				dave_npc.get_node("LegL").rotation_degrees.x = sin(t * 0.9) * 28.0
				dave_npc.get_node("LegR").rotation_degrees.x = -sin(t * 0.9) * 28.0

	if kev_npc and van_body:
		var van_on_street = van_body.global_position.z < 10.0
		if van_on_street and not active_driver and not van_locked:
			var dir_k = (van_body.global_position - kev_npc.global_position).normalized()
			dir_k.y = 0
			if kev_npc.global_position.distance_to(van_body.global_position) > 2.4:
				kev_npc.global_position += dir_k * 2.1 * delta
				kev_npc.rotation.y = atan2(-dir_k.x, -dir_k.z)
				kev_npc.get_node("LegL").rotation_degrees.x = sin(t * 1.1) * 30.0
				kev_npc.get_node("LegR").rotation_degrees.x = -sin(t * 1.1) * 30.0
			else:
				kev_steal_timer += delta
				if kev_steal_timer >= 6.0 and player:
					kev_steal_timer = 0.0
					if player.stock["CCTV"] > 0:
						player.stock["CCTV"] -= 1
						player.update_hud()
						player.show_toast("🚨 STICKY-FINGERS KEV NICKED A 4K CCTV KIT! Lock your van with [L]!")
					kev_npc.global_position = Vector3(-95, 0.1, 6.8)

	if active_driver and van_body:
		var throttle = Input.get_axis("move_back", "move_forward")
		var steer = Input.get_axis("move_right", "move_left")
		van_speed = move_toward(van_speed, throttle * 19.0, 22.0 * delta)
		if abs(van_speed) > 0.4:
			var dir_mult = 1.0 if van_speed > 0 else -1.0
			van_body.rotate_y(steer * 1.9 * dir_mult * delta)
		van_body.velocity = -van_body.global_transform.basis.z * van_speed
		if not van_body.is_on_floor():
			van_body.velocity.y = -9.8
		van_body.move_and_slide()
		active_driver.global_position = van_body.global_position + Vector3(-1.8, 0.8, 0)
