	lbl.position = pos
	lbl.rotation_degrees.y = rot_y
	lbl.text = text_str
	lbl.font_size = f_size
	lbl.modulate = col
	lbl.outline_size = 10
	lbl.outline_modulate = Color("0f172a")
	parent.add_child(lbl)
	return lbl

